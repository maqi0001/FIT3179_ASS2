{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "BIVARIATE CHOROPLETH. Each region gets one of 9 colours from two variables ranked within the region's own history: crop-season rain (A wettest ... C driest) and wheat harvest (1 best ... 3 worst). The code such as 'C3' is precomputed in data/wide.json (fields bv1991 ... bv2023); parameter 'byr' is set by the slider. The small square on the right is a hand-built colour key made from inline data; its axis labels state the score ranges (wet/good 67-100, middle 33-67, dry/poor 0-33).",
  "params": [
    {
      "name": "byr",
      "value": 2020
    }
  ],
  "hconcat": [
    {
      "width": 340,
      "height": 340,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -134,
          0,
          0
        ]
      },
      "data": {
        "url": "data/aagis_regions.topojson",
        "format": {
          "type": "topojson",
          "feature": "aagis"
        }
      },
      "transform": [
        {
          "lookup": "properties.aagis",
          "from": {
            "data": {
              "url": "data/wide.json"
            },
            "key": "code",
            "fields": [
              "name",
              "bv1991",
              "bv1992",
              "bv1993",
              "bv1994",
              "bv1995",
              "bv1996",
              "bv1997",
              "bv1998",
              "bv1999",
              "bv2000",
              "bv2001",
              "bv2002",
              "bv2003",
              "bv2004",
              "bv2005",
              "bv2006",
              "bv2007",
              "bv2008",
              "bv2009",
              "bv2010",
              "bv2011",
              "bv2012",
              "bv2013",
              "bv2014",
              "bv2015",
              "bv2016",
              "bv2017",
              "bv2018",
              "bv2019",
              "bv2020",
              "bv2021",
              "bv2022",
              "bv2023",
              "tb1991",
              "tb1992",
              "tb1993",
              "tb1994",
              "tb1995",
              "tb1996",
              "tb1997",
              "tb1998",
              "tb1999",
              "tb2000",
              "tb2001",
              "tb2002",
              "tb2003",
              "tb2004",
              "tb2005",
              "tb2006",
              "tb2007",
              "tb2008",
              "tb2009",
              "tb2010",
              "tb2011",
              "tb2012",
              "tb2013",
              "tb2014",
              "tb2015",
              "tb2016",
              "tb2017",
              "tb2018",
              "tb2019",
              "tb2020",
              "tb2021",
              "tb2022",
              "tb2023"
            ]
          }
        },
        {
          "calculate": "datum['bv'+byr]",
          "as": "key"
        },
        {
          "calculate": "datum['tb'+byr]",
          "as": "tip"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "color": {
          "field": "key",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "A1",
              "B1",
              "C1",
              "A2",
              "B2",
              "C2",
              "A3",
              "B3",
              "C3"
            ],
            "range": [
              "#e8e8e8",
              "#ace4e4",
              "#5ac8c8",
              "#dfb0d6",
              "#a5add3",
              "#5698b9",
              "#be64ac",
              "#8c62aa",
              "#3b4994"
            ]
          },
          "condition": {
            "test": "!isValid(datum.key)",
            "value": "#f1eadf"
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Region"
          },
          {
            "field": "tip",
            "title": "Details"
          }
        ]
      }
    },
    {
      "title": {
        "text": [
          "Colour key",
          "(scores run 0 to 100)"
        ],
        "fontSize": 11,
        "anchor": "start",
        "offset": 10,
        "lineHeight": 13
      },
      "width": 105,
      "height": 105,
      "data": {
        "values": [
          {
            "key": "A1",
            "rain": 0,
            "harvest": 0
          },
          {
            "key": "B1",
            "rain": 1,
            "harvest": 0
          },
          {
            "key": "C1",
            "rain": 2,
            "harvest": 0
          },
          {
            "key": "A2",
            "rain": 0,
            "harvest": 1
          },
          {
            "key": "B2",
            "rain": 1,
            "harvest": 1
          },
          {
            "key": "C2",
            "rain": 2,
            "harvest": 1
          },
          {
            "key": "A3",
            "rain": 0,
            "harvest": 2
          },
          {
            "key": "B3",
            "rain": 1,
            "harvest": 2
          },
          {
            "key": "C3",
            "rain": 2,
            "harvest": 2
          }
        ]
      },
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "rain",
          "type": "ordinal",
          "title": "Rain: wetter \u2192 drier",
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAngle": 0,
            "labelFontSize": 10,
            "titleFontSize": 11,
            "titleFontWeight": "normal",
            "labelExpr": "datum.value == 0 ? ['Wet', '67-100'] : datum.value == 1 ? ['Middle', '33-67'] : ['Dry', '0-33']"
          }
        },
        "y": {
          "field": "harvest",
          "type": "ordinal",
          "sort": "descending",
          "title": "Harvest: better \u2192 worse",
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAngle": 0,
            "labelFontSize": 10,
            "titleFontSize": 11,
            "titleFontWeight": "normal",
            "labelPadding": 4,
            "labelExpr": "datum.value == 0 ? ['Good', '67-100'] : datum.value == 1 ? ['Middle', '33-67'] : ['Poor', '0-33']"
          }
        },
        "color": {
          "field": "key",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "A1",
              "B1",
              "C1",
              "A2",
              "B2",
              "C2",
              "A3",
              "B3",
              "C3"
            ],
            "range": [
              "#e8e8e8",
              "#ace4e4",
              "#5ac8c8",
              "#dfb0d6",
              "#a5add3",
              "#5698b9",
              "#be64ac",
              "#8c62aa",
              "#3b4994"
            ]
          }
        }
      }
    }
  ],
  "spacing": 14,
  "config": {
    "font": "Source Sans 3, Helvetica, Arial, sans-serif",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}