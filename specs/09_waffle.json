{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "WAFFLE CHART (10 x 10 grid of squares, 1 square = 1 in 100 region-seasons). Red squares = harvests below 70% of normal. Left = driest third of seasons, right = wettest third. Data: data/waffle.json (one row per square, with its column, row and whether it is red).",
  "data": {
    "url": "data/waffle.json"
  },
  "facet": {
    "column": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "sort": [
        "Driest third of years",
        "Wettest third of years"
      ],
      "header": {
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "labelOrient": "bottom",
        "labelPadding": 8,
        "labelExpr": "datum.value == 'Driest third of years' ? [datum.value, '55 in 100 below 70% of normal'] : [datum.value, '2 in 100 below 70% of normal']"
      }
    }
  },
  "spec": {
    "width": 225,
    "height": 225,
    "mark": {
      "type": "rect",
      "stroke": "white",
      "strokeWidth": 2
    },
    "encoding": {
      "x": {
        "field": "col",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "axis": null,
        "sort": "descending"
      },
      "color": {
        "field": "hit",
        "type": "nominal",
        "title": null,
        "scale": {
          "domain": [
            true,
            false
          ],
          "range": [
            "#a50f15",
            "#e3dfd6"
          ]
        },
        "legend": {
          "orient": "bottom",
          "labelExpr": "datum.label == 'true' ? 'Below 70% of normal' : '70% or more'",
          "symbolType": "square"
        }
      }
    }
  },
  "spacing": 22,
  "config": {
    "font": "Source Sans 3, Helvetica, Arial, sans-serif",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}