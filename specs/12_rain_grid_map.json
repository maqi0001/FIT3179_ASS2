{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "GRIDDED MAP in 4 panels (concat, 2 columns, one shared colour scale). Each square is a 0.5 degree grid cell (about 50 km) coloured by April-October rainfall as % of its 1991-2022 average. Data: data/rain_grid.json from SILO monthly rainfall; fields s0-s3 hold the four seasons. Squares are 'square' marks placed by longitude and latitude. A thin outline of the farming regions is drawn on top.",
  "concat": [
    {
      "title": {
        "text": "2002-03",
        "subtitle": "Millennium drought",
        "anchor": "start",
        "fontSize": 14,
        "subtitleFontSize": 11,
        "subtitleColor": "#666"
      },
      "width": 330,
      "height": 300,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -134,
          0,
          0
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/rain_grid.json"
          },
          "transform": [
            {
              "calculate": "datum.s0",
              "as": "pct"
            }
          ],
          "mark": {
            "type": "square",
            "size": 30,
            "strokeWidth": 0,
            "opacity": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "color": {
              "field": "pct",
              "type": "quantitative",
              "title": "Rain vs usual",
              "scale": {
                "domain": [
                  0,
                  50,
                  100,
                  150,
                  200
                ],
                "range": [
                  "#7a3f06",
                  "#d9a85a",
                  "#f4efe3",
                  "#6fc3b6",
                  "#015a52"
                ],
                "clamp": true
              },
              "legend": {
                "values": [
                  0,
                  50,
                  100,
                  150,
                  200
                ],
                "orient": "bottom",
                "direction": "horizontal",
                "gradientLength": 280,
                "format": "d"
              }
            },
            "tooltip": [
              {
                "field": "pct",
                "title": "% of usual crop-season rain"
              },
              {
                "field": "avg",
                "title": "Usual Apr-Oct rain (mm)"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/aagis_regions.topojson",
            "format": {
              "type": "topojson",
              "feature": "aagis"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": null,
            "stroke": "#8a8478",
            "strokeWidth": 0.4,
            "opacity": 0.7
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 111,
                "lat": -41
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 10.5,
            "lineHeight": 12.5,
            "color": "#333",
            "fontWeight": "bold",
            "text": [
              "Brown almost everywhere:",
              "the typical square got",
              "27% of its usual rain"
            ]
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        }
      ]
    },
