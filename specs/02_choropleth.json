      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ]
  },
  "data": {
    "url": "data/aagis_regions.topojson",
    "format": {
      "type": "topojson",
      "feature": "aagis"
    }
  },
  "transform": [
    {
      "lookup": "properties.aagis",
      "from": {
        "data": {
          "url": "data/wide.json"
