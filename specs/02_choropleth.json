{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "CHOROPLETH MAP of the ABARES farming regions coloured by rainfall score. Geometry: data/aagis_regions.topojson. Rainfall: data/wide.json, which has one column per season (rf1991 ... rf2023); a 'lookup' joins it to the map by region code and 'calculate' picks the column for the chosen season. Parameter 'yr' (season end year) is set by the slider added in js/main.js. Projection: conicEqualArea centred on Australia. The 8 capital cities are small dots with white-haloed labels (function city_layers, inline data, no extra dataset).",
  "width": 520,
  "height": 420,
  "params": [
    {
      "name": "yr",
      "value": 2019
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aagis_regions.topojson",
        "format": {
          "type": "topojson",
          "feature": "aagis"
        }
      },
      "transform": [
        {
          "lookup": "properties.aagis",
          "from": {
            "data": {
              "url": "data/wide.json"
            },
            "key": "code",
            "fields": [
              "name",
              "rf1991",
              "rf1992",
              "rf1993",
              "rf1994",
              "rf1995",
              "rf1996",
              "rf1997",
              "rf1998",
              "rf1999",
              "rf2000",
              "rf2001",
              "rf2002",
              "rf2003",
              "rf2004",
              "rf2005",
              "rf2006",
              "rf2007",
              "rf2008",
              "rf2009",
              "rf2010",
              "rf2011",
              "rf2012",
              "rf2013",
              "rf2014",
              "rf2015",
              "rf2016",
              "rf2017",
              "rf2018",
              "rf2019",
              "rf2020",
              "rf2021",
              "rf2022",
              "rf2023",
              "tf1991",
              "tf1992",
              "tf1993",
              "tf1994",
              "tf1995",
              "tf1996",
              "tf1997",
              "tf1998",
              "tf1999",
              "tf2000",
              "tf2001",
              "tf2002",
              "tf2003",
              "tf2004",
              "tf2005",
              "tf2006",
              "tf2007",
              "tf2008",
              "tf2009",
              "tf2010",
              "tf2011",
              "tf2012",
              "tf2013",
              "tf2014",
              "tf2015",
              "tf2016",
              "tf2017",
              "tf2018",
              "tf2019",
              "tf2020",
              "tf2021",
              "tf2022",
              "tf2023"
            ]
          }
        },
        {
          "calculate": "datum['rf'+yr]",
          "as": "rain"
        },
        {
          "calculate": "datum['tf'+yr]",
          "as": "tip"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "color": {
          "field": "rain",
          "type": "quantitative",
          "title": "Rainfall (0-100)",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              "#8c510a",
              "#f6e8c3",
              "#c7eae5",
              "#01665e"
            ]
          },
          "legend": {
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "gradientLength": 240,
            "orient": "bottom",
            "direction": "horizontal"
          },
          "condition": {
            "test": "!isValid(datum.rain)",
            "value": "#e6e1d8"
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "Region"
          },
          {
            "field": "tip",
            "title": "How wet?"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "a": 1
          }
        ]
