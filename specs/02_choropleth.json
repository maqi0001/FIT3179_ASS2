    },
    {
      "calculate": "datum['rf'+yr]",
      "as": "rain"
    },
    {
      "calculate": "datum['tf'+yr]",
      "as": "tip"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.6
  },
  "encoding": {
    "color": {
      "field": "rain",
      "type": "quantitative",
      "title": "Rainfall (0-100)",
      "scale": {
        "domain": [
          0,
          100
        ],
        "range": [
          "#8c510a",
          "#f6e8c3",
          "#c7eae5",
          "#01665e"
        ]
      },
      "legend": {
        "values": [
          0,
          25,
          50,
          75,
          100
        ],
        "gradientLength": 240,
        "orient": "bottom",
        "direction": "horizontal"
      },
      "condition": {
        "test": "!isValid(datum.rain)",
        "value": "#e6e1d8"
      }
    },
    "tooltip": [
      {
        "field": "properties.name",
        "title": "Region"
      },
      {
        "field": "tip",
        "title": "How wet?"
      }
    ]
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Helvetica, Arial, sans-serif",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
