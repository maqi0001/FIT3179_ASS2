{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "SLOPE CHART. Each line is one grain-belt region, from its usual (middle) harvest on the left to its harvest in the chosen dry season on the right. Data: data/slope.json. Parameter 'pickseason' is set by the slider. Colour is a threshold scale on % of usual harvest (under 40 red, 40-70 orange, 70 and over blue). Region names are not printed (they would crowd the right side); hover a point to see the name in the tooltip. The third layer is a small italic reading hint.",
  "width": 320,
  "height": 340,
  "params": [
    {
      "name": "pickseason",
      "value": "2002-03"
    }
  ],
  "data": {
    "url": "data/slope.json"
  },
  "transform": [
    {
      "filter": "datum.pick == pickseason"
    }
  ],
  "encoding": {
    "x": {
      "field": "point",
      "type": "nominal",
      "title": null,
      "sort": [
        "A typical season",
        "The dry season"
      ],
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "orient": "top",
        "domain": false,
        "ticks": false
      },
      "scale": {
        "padding": 0.4
      }
    },
    "y": {
      "field": "yield",
      "type": "quantitative",
      "title": "Wheat harvest (tonnes per hectare)",
      "scale": {
        "zero": true
      }
    },
    "color": {
      "field": "kept",
      "type": "quantitative",
      "title": "Harvest as % of typical",
      "scale": {
        "type": "threshold",
        "domain": [
          40,
          70
        ],
        "range": [
          "#a50f15",
          "#e08a3c",
          "#4a7ba6"
        ]
      },
      "legend": {
        "orient": "bottom",
        "format": "d",
        "direction": "horizontal",
        "titleLimit": 300
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "opacity": 0.9
      },
      "encoding": {
        "detail": {
          "field": "region",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 60
      },
      "encoding": {
        "tooltip": [
          {
            "field": "region",
            "title": "Region"
          },
          {
            "field": "yield",
            "title": "Harvest (t/ha)",
            "format": ".2f"
          },
          {
            "field": "kept",
            "title": "% of typical",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "a": 1
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#555",
        "lineHeight": 13,
        "text": [
          "Each line is one region (hover to see its name).",
          "Steeper fall = bigger loss"
        ]
      },
      "encoding": {
        "x": {
          "value": 160
        },
        "y": {
          "value": 318
        },
        "color": {
          "value": "#555"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3, Helvetica, Arial, sans-serif",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}