{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "PARALLEL COORDINATES. Each thin line is a region, joined across four 0-100 scores: Rainfall, Pasture growth, Wheat yield, Farm profit (data/parallel.json). Colour = zone. The thick black line is the average of all regions for the season chosen with the slider (parameter 'pyr'). Only regions that have all four scores are included.",
  "width": 440,
  "height": 340,
  "params": [
    {
      "name": "pyr",
      "value": 2003
    }
  ],
  "data": {
    "url": "data/parallel.json"
  },
  "transform": [
    {
      "filter": "datum.year == pyr"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.8,
        "opacity": 0.55
      },
      "encoding": {
        "x": {
          "field": "indicator",
          "type": "nominal",
          "title": null,
          "sort": [
            "Rainfall",
            "Pasture growth",
            "Wheat yield",
            "Farm profit"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 12,
            "grid": true,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 0.1
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "Score (0 = worst on record, 100 = best)",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "color": {
          "field": "zone",
          "type": "nominal",
          "title": "Zone",
          "scale": {
            "domain": [
              "Wheat Sheep",
              "High Rainfall",
              "Pastoral"
            ],
            "range": [
              "#b5651d",
              "#2a7f9e",
              "#8a8a8a"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "detail": {
          "field": "region",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "region",
            "title": "Region"
          },
          {
            "field": "indicator",
            "title": "Measure"
          },
          {
            "field": "value",
            "title": "Score",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "value",
              "as": "avg"
            }
          ],
          "groupby": [
            "indicator"
          ]
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 4.5,
        "color": "#222",
        "point": {
          "filled": true,
          "size": 90,
          "color": "#222"
        }
      },
      "encoding": {
        "x": {
          "field": "indicator",
          "type": "nominal",
          "title": null,
          "sort": [
            "Rainfall",
            "Pasture growth",
            "Wheat yield",
            "Farm profit"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 12,
            "grid": true,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 0.1
          }
        },
        "y": {
          "field": "avg",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "tooltip": [
          {
            "field": "indicator",
            "title": "Measure"
          },
          {
            "field": "avg",
            "title": "Average of all regions",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "value",
              "as": "avg"
            }
          ],
          "groupby": [
            "indicator"
          ]
        },
        {
          "filter": "datum.indicator == 'Rainfall'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": 18,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#222"
      },
      "encoding": {
        "x": {
          "field": "indicator",
          "type": "nominal",
          "title": null,
          "sort": [
            "Rainfall",
            "Pasture growth",
            "Wheat yield",
            "Farm profit"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 12,
            "grid": true,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 0.1
          }
        },
        "y": {
          "field": "avg",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "text": {
          "value": "Average of all regions"
        }
      }
    }
  ],
  "config": {
    "font": "Source Sans 3, Helvetica, Arial, sans-serif",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}