{
  "width": 440,
  "height": 340,
  "params": [
    {
      "name": "pyr",
      "value": 2003,
      "bind": {
        "input": "select",
        "options": [
          1991,
          1992,
          1993,
          1994,
          1995,
          1996,
          1997,
          1998,
          1999,
          2000,
          2001,
          2002,
          2003,
          2004,
          2005,
          2006,
          2007,
          2008,
          2009,
          2010,
          2011,
          2012,
          2013,
          2014,
          2015,
          2016,
          2017,
          2018,
          2019,
          2020,
          2021,
          2022,
          2023
        ],
        "labels": [
          "1990-91",
          "1991-92",
          "1992-93",
          "1993-94",
          "1994-95",
          "1995-96",
          "1996-97",
          "1997-98",
          "1998-99",
          "1999-00",
          "2000-01",
          "2001-02",
          "2002-03",
          "2003-04",
          "2004-05",
          "2005-06",
          "2006-07",
          "2007-08",
          "2008-09",
          "2009-10",
          "2010-11",
          "2011-12",
          "2012-13",
          "2013-14",
          "2014-15",
          "2015-16",
          "2016-17",
          "2017-18",
          "2018-19",
          "2019-20",
          "2020-21",
          "2021-22",
          "2022-23"
        ],
        "name": "Season (July-June): "
      }
    }
  ],
  "data": {
    "url": "data/parallel.json"
  },
  "transform": [
    {
      "filter": "datum.year == pyr"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.8,
        "opacity": 0.55
      },
      "encoding": {
        "x": {
          "field": "indicator",
          "type": "nominal",
          "title": null,
          "sort": [
            "Rainfall",
            "Pasture growth",
            "Wheat yield",
            "Farm profit"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 12,
            "grid": true,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 0.1
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "Score (0 = worst on record, 100 = best)",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "color": {
          "field": "zone",
          "type": "nominal",
          "title": "Zone",
          "scale": {
            "domain": [
              "Wheat Sheep",
              "High Rainfall",
              "Pastoral"
            ],
            "range": [
              "#b5651d",
              "#2a7f9e",
              "#8a8a8a"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "detail": {
          "field": "region",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "region",
            "title": "Region"
          },
          {
            "field": "indicator",
            "title": "Measure"
          },
          {
            "field": "value",
            "title": "Score",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "value",
              "as": "avg"
            }
          ],
          "groupby": [
            "indicator"
          ]
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 4.5,
        "color": "#222",
        "point": {
          "filled": true,
          "size": 90,
          "color": "#222"
        }
      },
      "encoding": {
        "x": {
          "field": "indicator",
          "type": "nominal",
          "title": null,
          "sort": [
            "Rainfall",
            "Pasture growth",
            "Wheat yield",
            "Farm profit"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 12,
            "grid": true,
            "domain": false,
            "ticks": false
          },
          "scale": {
            "padding": 0.1
          }
        },
        "y": {
          "field": "avg",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "tooltip": [
          {
            "field": "indicator",
            "title": "Measure"
          },
          {
            "field": "avg",
            "title": "Average of all regions",
            "format": ".0f"
          }
        ]
      }
    }
  ],
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Helvetica, Arial, sans-serif",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}