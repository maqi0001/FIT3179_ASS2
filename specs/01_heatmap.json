            "domain": [
              0,
              100
            ],
            "range": [
              "#8c510a",
              "#f6e8c3",
              "#c7eae5",
              "#01665e"
            ]
          },
          "legend": {
            "values": [
              0,
              25,
              50,
              75,
              100
