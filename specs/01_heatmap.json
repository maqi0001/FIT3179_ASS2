{
  "params": [
    {
      "name": "measure",
      "value": "rain_fy",
      "bind": {
        "input": "radio",
        "options": [
          "rain_fy",
          "rain_win"
        ],
        "labels": [
          "Whole year (July-June)",
          "Crop season (April-October)"
        ],
        "name": "Show: "
      }
    }
