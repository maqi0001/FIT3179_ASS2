    {
      "title": {
        "text": "Pastoral",
        "anchor": "start",
        "fontSize": 12
      },
      "width": 363,
      "height": 154,
      "data": {
        "url": "data/regions.json"
      },
      "transform": [
        {
          "filter": "datum.zone == 'Pastoral'"
        },
        {
          "calculate": "datum[measure]",
          "as": "rain"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "season",
          "type": "ordinal",
          "title": null,
          "axis": {
            "values": [
              "1990-91",
              "1994-95",
              "1998-99",
              "2002-03",
              "2006-07",
              "2010-11",
              "2014-15",
              "2018-19",
              "2022-23",
