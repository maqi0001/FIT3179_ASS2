{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "HEATMAP (3 stacked panels = small multiples by zone: Pastoral, Wheat-Sheep, High Rainfall). Rows = regions, columns = seasons, colour = rainfall score 0-100 (brown dry, teal wet). Data: data/regions.json (AADI). The radio button is the parameter 'measure': it picks column rain_fy (whole year) or rain_win (April-October) through a 'calculate' transform. The first panel has an extra text layer that labels 2002-03, 2010-11 and 2018-19.",
  "params": [
    {
      "name": "measure",
      "value": "rain_fy",
      "bind": {
        "input": "radio",
        "options": [
          "rain_fy",
          "rain_win"
        ],
        "labels": [
          "Whole year (July-June)",
          "Crop season (April-October)"
        ],
        "name": "Show: "
      }
    }
  ],
  "vconcat": [
    {
      "title": {
        "text": "Pastoral",
        "anchor": "start",
        "fontSize": 12
      },
      "width": 330,
      "height": 154,
      "data": {
        "url": "data/regions.json"
      },
      "transform": [
        {
          "filter": "datum.zone == 'Pastoral'"
        },
        {
          "calculate": "datum[measure]",
          "as": "rain"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "stroke": "white",
            "strokeWidth": 0.5
          },
          "encoding": {
            "x": {
              "field": "season",
              "type": "ordinal",
              "title": null,
              "axis": {
                "values": [
                  "1990-91",
                  "1994-95",
                  "1998-99",
                  "2002-03",
                  "2006-07",
                  "2010-11",
                  "2014-15",
                  "2018-19",
                  "2022-23",
                  "2022-23"
                ],
                "labelAngle": -45,
                "grid": false,
                "labels": false,
                "ticks": false,
                "domain": false
              }
            },
            "y": {
              "field": "region",
              "type": "nominal",
              "sort": [
                "NSW Far West",
                "NT Alice Springs Districts",
                "NT Barkly Tablelands",
                "NT Victoria River District - Katherine",
                "QLD Cape York and the Gulf",
                "QLD Central North",
                "QLD Charleville - Longreach",
                "QLD West and South West",
                "SA Northern Pastoral",
                "WA Pilbara and Central Pastoral",
                "WA The Kimberley"
              ],
              "title": null,
              "axis": {
                "labelLimit": 240,
                "ticks": false,
                "domain": false
              }
            },
            "color": {
              "field": "rain",
              "type": "quantitative",
              "title": "Score",
              "scale": {
                "domain": [
                  0,
                  100
                ],
                "range": [
                  "#8c510a",
                  "#f6e8c3",
                  "#c7eae5",
                  "#01665e"
                ]
              },
              "legend": {
                "values": [
                  0,
                  25,
                  50,
                  75,
                  100
                ],
                "gradientLength": 140
              }
            },
            "tooltip": [
              {
                "field": "region",
                "title": "Region"
              },
              {
                "field": "season",
                "title": "Season"
              },
              {
                "field": "rain",
                "title": "Rainfall (0-100)",
                "format": ".0f"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "season": "2002-03",
                "t": "2002-03 dry"
              },
              {
                "season": "2010-11",
                "t": "2010-11 wet"
              },
              {
                "season": "2018-19",
                "t": "2018-19 dry"
              }
            ]
          },
          "transform": [],
          "mark": {
            "type": "text",
            "baseline": "bottom",
            "dy": -4,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#3b2a14"
          },
          "encoding": {
            "x": {
              "field": "season",
              "type": "ordinal",
              "sort": [
                "1990-91",
                "1991-92",
                "1992-93",
                "1993-94",
                "1994-95",
                "1995-96",
                "1996-97",
                "1997-98",
                "1998-99",
                "1999-00",
                "2000-01",
                "2001-02",
                "2002-03",
                "2003-04",
                "2004-05",
                "2005-06",
                "2006-07",
                "2007-08",
                "2008-09",
                "2009-10",
                "2010-11",
                "2011-12",
                "2012-13",
                "2013-14",
                "2014-15",
                "2015-16",
                "2016-17",
                "2017-18",
                "2018-19",
                "2019-20",
                "2020-21",
                "2021-22",
                "2022-23"
              ]
            },
            "y": {
              "value": 0
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "Wheat-Sheep",
        "anchor": "start",
        "fontSize": 12
      },
      "width": 330,
      "height": 168,
      "data": {
        "url": "data/regions.json"
      },
      "transform": [
        {
          "filter": "datum.zone == 'Wheat Sheep'"
        },
        {
          "calculate": "datum[measure]",
          "as": "rain"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "season",
          "type": "ordinal",
          "title": null,
          "axis": {
            "values": [
              "1990-91",
              "1994-95",
              "1998-99",
              "2002-03",
              "2006-07",
              "2010-11",
              "2014-15",
              "2018-19",
              "2022-23",
              "2022-23"
            ],
            "labelAngle": -45,
            "grid": false,
            "labels": false,
            "ticks": false,
            "domain": false
          }
        },
        "y": {
          "field": "region",
          "type": "nominal",
          "sort": [
            "NSW Central West",
            "NSW North West Slopes and Plains",
            "NSW Riverina",
            "QLD Eastern Darling Downs",
            "QLD Western Downs and Central Highlands",
            "SA Eyre Peninsula",
            "SA Murray Lands and Yorke Peninsula",
            "VIC Central North",
            "VIC Mallee",
            "VIC Wimmera",
            "WA Central and Southern Wheat Belt",
            "WA Northern and Eastern Wheat Belt"
          ],
          "title": null,
          "axis": {
            "labelLimit": 240,
            "ticks": false,
            "domain": false
          }
        },
        "color": {
          "field": "rain",
          "type": "quantitative",
          "title": "Score",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              "#8c510a",
              "#f6e8c3",
              "#c7eae5",
              "#01665e"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "region",
            "title": "Region"
          },
          {
            "field": "season",
            "title": "Season"
          },
          {
            "field": "rain",
            "title": "Rainfall (0-100)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "title": {
        "text": "High Rainfall",
        "anchor": "start",
        "fontSize": 12
      },
      "width": 330,
      "height": 112,
      "data": {
        "url": "data/regions.json"
      },
      "transform": [
        {
          "filter": "datum.zone == 'High Rainfall'"
        },
        {
          "calculate": "datum[measure]",
          "as": "rain"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "season",
          "type": "ordinal",
          "title": null,
          "axis": {
            "values": [
              "1990-91",
              "1994-95",
              "1998-99",
              "2002-03",
              "2006-07",
              "2010-11",
              "2014-15",
              "2018-19",
              "2022-23",
              "2022-23"
            ],
            "labelAngle": -45,
            "grid": false,
            "labels": true,
            "ticks": true,
            "domain": true
          }
        },
        "y": {
          "field": "region",
          "type": "nominal",
          "sort": [
            "NSW Coastal",
            "NSW Tablelands (Northern Central and Southern)",
            "QLD Northern Coastal - Mackay to Cairns",
            "QLD Southern Coastal - Curtis to Moreton",
            "SA South East",
            "TAS Tasmania",
            "VIC Southern and Eastern Victoria",
            "WA South West Coastal"
          ],
          "title": null,
          "axis": {
            "labelLimit": 240,
            "ticks": false,
            "domain": false
          }
        },
        "color": {
          "field": "rain",
          "type": "quantitative",
          "title": "Score",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              "#8c510a",
              "#f6e8c3",
              "#c7eae5",
              "#01665e"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "region",
            "title": "Region"
          },
          {
            "field": "season",
            "title": "Season"
          },
          {
            "field": "rain",
            "title": "Rainfall (0-100)",
            "format": ".0f"
          }
        ]
      }
    }
  ],
  "spacing": 12,
  "resolve": {
    "scale": {
      "color": "shared",
      "x": "shared"
    }
  },
  "config": {
    "font": "Source Sans 3, Helvetica, Arial, sans-serif",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}