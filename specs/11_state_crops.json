{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "HEATMAP of crop yields by state (facet by state). Rows = crops, columns = seasons, colour = yield as % of that crop's usual (middle) yield in the state. Yield = production / area from the ABARES Australian Crop Report (Sept 2026), data/state_crops.json. Each state has its own y scale so crops a state does not grow are not shown. Cotton and rice are irrigated.",
  "data": {
    "url": "data/state_crops.json"
  },
  "facet": {
    "row": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": [
        "Western Australia",
        "South Australia",
        "Victoria",
        "New South Wales",
        "Queensland"
      ],
      "header": {
        "labelAngle": 0,
        "labelOrient": "top",
        "labelAnchor": "start",
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "labelPadding": 2
      }
    }
  },
  "spacing": 8,
  "spec": {
    "width": 690,
    "height": {
      "step": 16
    },
    "encoding": {
      "x": {
        "field": "season",
        "type": "ordinal",
        "sort": [
          "1989-90",
          "1990-91",
          "1991-92",
          "1992-93",
          "1993-94",
          "1994-95",
          "1995-96",
          "1996-97",
          "1997-98",
          "1998-99",
          "1999-00",
          "2000-01",
          "2001-02",
          "2002-03",
          "2003-04",
          "2004-05",
          "2005-06",
          "2006-07",
          "2007-08",
          "2008-09",
          "2009-10",
          "2010-11",
          "2011-12",
          "2012-13",
          "2013-14",
          "2014-15",
          "2015-16",
          "2016-17",
          "2017-18",
          "2018-19",
          "2019-20",
          "2020-21",
          "2021-22",
          "2022-23",
          "2023-24",
          "2024-25",
          "2025-26"
        ],
        "title": null,
        "axis": {
          "values": [
            "1990-91",
            "1994-95",
            "1998-99",
            "2002-03",
            "2006-07",
            "2010-11",
            "2014-15",
            "2018-19",
            "2022-23"
          ],
          "labelAngle": -40,
          "ticks": false,
          "domain": false,
          "orient": "bottom"
        }
      },
      "y": {
        "field": "crop",
        "type": "nominal",
        "sort": {
          "field": "ord",
          "op": "min"
        },
        "title": null,
        "axis": {
          "ticks": false,
          "domain": false,
          "labelLimit": 160
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "rect",
          "stroke": "white",
          "strokeWidth": 0.5
        },
        "encoding": {
          "color": {
            "field": "pct",
            "type": "quantitative",
            "title": "Yield vs typical (%)",
            "scale": {
              "domain": [
                0,
                50,
                100,
                150,
                200
              ],
              "range": [
                "#7a3f06",
                "#d9a85a",
                "#f4efe3",
                "#6fc3b6",
                "#015a52"
              ],
              "clamp": true
            },
            "legend": {
              "values": [
                0,
                50,
                100,
                150,
                200
              ],
              "orient": "bottom",
              "direction": "horizontal",
              "gradientLength": 280,
              "format": "d"
            }
          },
          "tooltip": [
            {
              "field": "state",
              "title": "State"
            },
            {
              "field": "crop",
              "title": "Crop"
            },
            {
              "field": "season",
              "title": "Season"
            },
            {
              "field": "pct",
              "title": "% of typical yield"
            },
            {
              "field": "yield",
              "title": "Yield (t/ha)",
              "format": ".2f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum.state == 'Victoria' && datum.crop == 'Wheat' && (datum.season == '2002-03' || datum.season == '2006-07')"
          }
        ],
        "mark": {
          "type": "rect",
          "fill": null,
          "stroke": "#222",
          "strokeWidth": 1.6
        },
        "encoding": {
          "y": {
            "value": 0
          },
          "y2": {
            "value": 80
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.state == 'Victoria' && datum.crop == 'Wheat' && datum.season == '2004-05'"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 11,
          "fontWeight": "bold",
          "color": "#222",
          "baseline": "bottom",
          "text": "Outlined: winter crops fail together"
        },
        "encoding": {
          "y": {
            "value": -3
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.state == 'New South Wales' && datum.season == '2022-23' && (datum.crop == 'Cotton (irrigated)' || datum.crop == 'Rice (irrigated)')"
          }
        ],
        "mark": {
          "type": "rect",
          "fill": null,
          "stroke": "#222",
          "strokeWidth": 1.6
        },
        "encoding": {
          "x": {
            "value": 0
          },
          "x2": {
            "value": 690
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.state == 'New South Wales' && datum.season == '2022-23' && datum.crop == 'Wheat'"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 11,
          "fontWeight": "bold",
          "color": "#222",
          "baseline": "bottom",
          "align": "right",
          "text": "Outlined: irrigated crops barely change"
        },
        "encoding": {
          "x": {
            "value": 690
          },
          "y": {
            "value": -3
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "config": {
    "font": "Source Sans 3, Helvetica, Arial, sans-serif",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}